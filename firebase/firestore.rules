rules_version = '2';

// Starting-point security rules for Clash of Jams.
//
// These enforce ownership and the design document's "no client writes to
// derived state" stance: elo, match outcomes and run validation are written by
// server-side code (Cloud Functions / Admin SDK), which bypasses these rules.
// Review before going anywhere near real users.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    function scenarioAuthor(scenarioId) {
      return get(/databases/$(database)/documents/scenarios/$(scenarioId)).data.authorUid;
    }

    // --- Document shapes -------------------------------------------------
    //
    // Mirrors frontend/src/lib/schema/types.ts for the base collections, so a
    // write with a missing, extra or wrongly typed field is rejected instead of
    // stored. request.resource.data is the whole post-write document, so these
    // hold for partial updates too. Keep them in step with types.ts.

    function isStringOrNull(v) {
      return v == null || v is string;
    }

    function isNumberOrNull(v) {
      return v == null || v is number;
    }

    // serverTimestamp() resolves to request.time, so this pins a creation time
    // to the server clock rather than whatever the client sent.
    function stampedNow(v) {
      return v is timestamp && v == request.time;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function hasExactly(d, fields) {
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields);
    }

    function isValidUser(d) {
      return hasExactly(d, ['uid', 'username', 'usernameLower', 'displayName', 'avatarUrl', 'bio',
            'role', 'isBanned', 'isSocialRestricted', 'isProfilePublic', 'createdAt', 'updatedAt'])
        && d.uid is string
        && d.username is string
        && d.usernameLower == d.username.lower()
        && d.displayName is string
        && isStringOrNull(d.avatarUrl)
        && d.bio is string
        && d.role in ['user', 'moderator', 'admin']
        && d.isBanned is bool
        && d.isSocialRestricted is bool
        && d.isProfilePublic is bool
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidScenario(d, scenarioId) {
      return hasExactly(d, ['id', 'authorUid', 'title', 'description', 'instrument', 'genres',
            'visibility', 'tags', 'authorDifficulty', 'crowdDifficulty', 'avgRating', 'ratingCount', 'playCount',
            'currentVersionId', 'currentVersionNumber', 'createdAt', 'updatedAt'])
        && d.id == scenarioId
        && d.authorUid is string
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && d.description is string
        && d.instrument in ['piano', 'guitar', 'woodwind', 'vocals', 'midi']
        && d.genres is list
        && d.visibility in ['private', 'unlisted', 'public']
        && d.tags is list
        && d.authorDifficulty is int && d.authorDifficulty >= 1 && d.authorDifficulty <= 10
        && isNumberOrNull(d.crowdDifficulty)
        && isNumberOrNull(d.avgRating)
        && d.ratingCount is int
        && d.playCount is int
        && isStringOrNull(d.currentVersionId)
        && d.currentVersionNumber is int
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidScenarioVersion(d, scenarioId, versionId) {
      return hasExactly(d, ['id', 'scenarioId', 'versionNumber', 'chart', 'scoringRules',
            'durationMs', 'mediaAssetIds', 'createdByUid', 'createdAt'])
        && d.id == versionId
        && d.scenarioId == scenarioId
        && d.versionNumber is int && d.versionNumber >= 1
        && d.chart is map
        && d.scoringRules is map
        && d.durationMs is number
        && d.mediaAssetIds is list
        && d.createdByUid is string
        && d.createdAt is timestamp;
    }

    function isValidRun(d, runId) {
      return hasExactly(d, ['id', 'userUid', 'scenarioId', 'scenarioVersionId', 'instrument',
            'partId', 'speedMultiplier', 'scoringRules', 'finalScore', 'breakdown', 'validation',
            'matchId', 'matchParticipantUid', 'playedAt'])
        && d.id == runId
        && d.userUid is string
        && d.scenarioId is string
        && d.scenarioVersionId is string
        && d.instrument in ['piano', 'guitar', 'woodwind', 'vocals', 'midi']
        && d.partId is string
        && d.speedMultiplier is number
        && d.scoringRules is map
        && d.finalScore is number
        && d.breakdown is map
        && d.validation in ['pending', 'accepted', 'rejected']
        && isStringOrNull(d.matchId)
        && isStringOrNull(d.matchParticipantUid)
        && d.playedAt is timestamp;
    }

    // Public profiles are readable; only the owner edits their own, and only
    // an admin can flip the moderation flags.
    match /users/{uid} {
      allow read: if resource.data.isProfilePublic == true || isSelf(uid) || isAdmin();
      // A new account always starts as an unrestricted standard user; roles
      // and moderation flags are granted later, by an admin.
      allow create: if isSelf(uid)
        && isValidUser(request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.isBanned == false
        && request.resource.data.isSocialRestricted == false
        && stampedNow(request.resource.data.createdAt);
      allow update: if isValidUser(request.resource.data)
        && unchanged('uid')
        && unchanged('createdAt')
        && (isAdmin()
          || (isSelf(uid)
              && unchanged('role')
              && unchanged('isBanned')
              && unchanged('isSocialRestricted')));
      allow delete: if isAdmin();

      // Ratings are readable for leaderboards. Sign-up creates one per
      // instrument at the starting values; every change after that is the
      // server's, so a client can never move its own elo.
      match /skillRatings/{instrument} {
        allow read: if signedIn();
        allow create: if isSelf(uid)
          && hasExactly(request.resource.data, ['uid', 'instrument', 'elo', 'tier', 'gamesPlayed',
                'isProvisional', 'updatedAt'])
          && request.resource.data.uid == uid
          && instrument in ['piano', 'guitar', 'woodwind', 'vocals', 'midi']
          && request.resource.data.instrument == instrument
          && request.resource.data.elo == 400
          && request.resource.data.tier == 'bronze'
          && request.resource.data.gamesPlayed == 0
          && request.resource.data.isProvisional == true
          && stampedNow(request.resource.data.updatedAt);
        allow update, delete: if false;
      }
    }

    // Reservations are public so the sign-up form can check availability, and
    // a user may only claim one that points at themselves.
    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if isSelf(request.resource.data.uid);
      allow update: if false;
      allow delete: if isSelf(resource.data.uid) || isAdmin();
    }

    match /userSettings/{uid} {
      allow read, write: if isSelf(uid);

      match /scenarioThemes/{themeName} {
        allow read, create, update, delete: if isSelf(uid);
      }
    }

    // The preset avatars offered on the profile editor. Read-only to clients.
    match /avatars/{avatarId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /scenarios/{scenarioId} {
      // A missing document reads as empty (not denied), so a deleted scenario
      // or a stale link resolves cleanly; it discloses nothing but absence.
      allow read: if resource == null
        || resource.data.visibility != 'private'
        || isSelf(resource.data.authorUid)
        || isAdmin();
      // Aggregates (ratings, plays, crowd difficulty) are derived server-side,
      // so a client creates them at their defaults and never edits them.
      allow create: if isSelf(request.resource.data.authorUid)
        && isValidScenario(request.resource.data, scenarioId)
        && request.resource.data.crowdDifficulty == null
        && request.resource.data.avgRating == null
        && request.resource.data.ratingCount == 0
        && request.resource.data.playCount == 0
        && stampedNow(request.resource.data.createdAt);
      allow update: if isValidScenario(request.resource.data, scenarioId)
        && unchanged('authorUid')
        && unchanged('createdAt')
        && (isAdmin()
          || (isSelf(resource.data.authorUid)
              && unchanged('crowdDifficulty')
              && unchanged('avgRating')
              && unchanged('ratingCount')
              && unchanged('playCount')));
      allow delete: if isSelf(resource.data.authorUid) || isAdmin();

      // Versions are immutable once written — edits create a new version.
      match /versions/{versionId} {
        allow read: if get(/databases/$(database)/documents/scenarios/$(scenarioId)).data.visibility != 'private'
          || isSelf(scenarioAuthor(scenarioId))
          || isAdmin();
        // getAfter, not get: a new scenario and its first version are written
        // in one batch, and get() would not see the scenario yet.
        allow create: if isSelf(getAfter(/databases/$(database)/documents/scenarios/$(scenarioId)).data.authorUid)
          && isValidScenarioVersion(request.resource.data, scenarioId, versionId)
          && isSelf(request.resource.data.createdByUid)
          && stampedNow(request.resource.data.createdAt);
        allow update, delete: if isAdmin();
      }
    }

    match /mediaAssets/{assetId} {
      allow read: if signedIn();
      allow create: if isSelf(request.resource.data.ownerUid);
      allow update, delete: if isSelf(resource.data.ownerUid) || isAdmin();
    }

    // A client may submit its own run as 'pending'; only the server accepts it.
    match /runs/{runId} {
      allow read: if signedIn();
      allow create: if isSelf(request.resource.data.userUid)
        && isValidRun(request.resource.data, runId)
        && request.resource.data.validation == 'pending'
        && stampedNow(request.resource.data.playedAt);
      allow update, delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if isSelf(request.resource.data.hostUid);
      // State transitions and the winner are decided server-side.
      allow update, delete: if false;

      match /participants/{uid} {
        allow read: if signedIn();
        // A player may join and toggle their own readiness; outcomes are server-written.
        allow create: if isSelf(uid);
        allow update: if isSelf(uid)
          && request.resource.data.outcome == resource.data.outcome
          && request.resource.data.eloDelta == resource.data.eloDelta;
        allow delete: if isSelf(uid) || isAdmin();
      }
    }

    match /friendships/{pairId} {
      allow read: if signedIn()
        && (isSelf(resource.data.idA) || isSelf(resource.data.idB));
      allow create: if isSelf(request.resource.data.requestedByUid)
        && request.resource.data.idA < request.resource.data.idB
        && (isSelf(request.resource.data.idA) || isSelf(request.resource.data.idB));
      allow update, delete: if isSelf(resource.data.idA) || isSelf(resource.data.idB) || isAdmin();
    }

    match /communities/{communityId} {
      allow read: if resource.data.isPublic == true || signedIn();
      allow create: if isSelf(request.resource.data.ownerUid);
      allow update, delete: if isSelf(resource.data.ownerUid) || isAdmin();

      match /members/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid) && request.resource.data.role == 'member';
        allow update, delete: if isSelf(uid)
          || isSelf(get(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid)
          || isAdmin();
      }
    }

    match /playlists/{playlistId} {
      allow read: if resource.data.isPublic == true || isSelf(resource.data.ownerUid);
      allow create: if isSelf(request.resource.data.ownerUid);
      allow update, delete: if isSelf(resource.data.ownerUid) || isAdmin();

      match /items/{itemId} {
        allow read: if get(/databases/$(database)/documents/playlists/$(playlistId)).data.isPublic == true
          || isSelf(get(/databases/$(database)/documents/playlists/$(playlistId)).data.ownerUid);
        allow write: if isSelf(get(/databases/$(database)/documents/playlists/$(playlistId)).data.ownerUid);
      }
    }

    // Document id is "{scenarioId}_{reviewerUid}", which is what makes one
    // review per user per scenario impossible to work around.
    match /scenarioReviews/{reviewId} {
      allow read: if true;
      allow create: if isSelf(request.resource.data.reviewerUid)
        && reviewId == request.resource.data.scenarioId + '_' + request.resource.data.reviewerUid;
      allow update: if isSelf(resource.data.reviewerUid);
      allow delete: if isSelf(resource.data.reviewerUid) || isAdmin();
    }

    match /userReports/{reportId} {
      allow read: if isSelf(resource.data.reporterUid) || isAdmin();
      allow create: if isSelf(request.resource.data.reporterUid)
        && request.resource.data.state == 'open';
      allow update, delete: if isAdmin();
    }

    match /moderationActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isSelf(request.resource.data.moderatorUid);
      allow update, delete: if false;
    }

    match /matchInvitations/{invitationId} {
      allow read: if isSelf(resource.data.fromUid) || isSelf(resource.data.toUid);
      allow create: if isSelf(request.resource.data.fromUid);
      allow update: if isSelf(resource.data.toUid) || isSelf(resource.data.fromUid);
      allow delete: if isSelf(resource.data.fromUid) || isAdmin();
    }

    match /recordingShares/{shareId} {
      allow read: if resource.data.visibility != 'private' || isSelf(resource.data.ownerUid);
      allow create: if isSelf(request.resource.data.ownerUid);
      allow update, delete: if isSelf(resource.data.ownerUid) || isAdmin();
    }

    match /importJobs/{jobId} {
      allow read: if isSelf(resource.data.ownerUid) || isAdmin();
      allow create: if isSelf(request.resource.data.ownerUid)
        && request.resource.data.state == 'queued';
      // The worker advances the job server-side.
      allow update, delete: if isAdmin();
    }

    // Schema bookkeeping written by scripts/init-firestore.ts.
    match /_schema/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
