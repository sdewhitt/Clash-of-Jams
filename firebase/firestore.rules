rules_version = '2';

// Starting-point security rules for Clash of Jams.
//
// These enforce ownership and the design document's "no client writes to
// derived state" stance: elo, match outcomes and run validation are written by
// server-side code (Cloud Functions / Admin SDK), which bypasses these rules.
// Review before going anywhere near real users.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && accountAllowsAccess(request.auth.uid);
    }

    // The backend owns accountDeletions/{uid}. A restored account keeps its
    // auth cutoff so a session issued before deletion cannot regain access.
    function accountAllowsAccess(uid) {
      let path = /databases/$(database)/documents/accountDeletions/$(uid);
      return !exists(path) || (get(path).data.state == 'active'
        && request.auth.token.auth_time > get(path).data.authAfter);
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    function canPostAnnouncement(communityId, memberUid) {
      return signedIn()
        && exists(/databases/$(database)/documents/communities/$(communityId))
        && get(/databases/$(database)/documents/communities/$(communityId)/members/$(memberUid)).data.role in ['owner', 'moderator'];
    }

    function pairId(uidOne, uidTwo) {
      return uidOne < uidTwo
        ? uidOne + '_' + uidTwo
        : uidTwo + '_' + uidOne;
    }

    function isFriendRequestParticipant(data) {
      return signedIn() &&
        data.potentialFriends is list &&
        data.potentialFriends.size() == 2 &&
        data.potentialFriends.hasAny([request.auth.uid]);
    }

    function isFriendshipParticipant(data) {
      return signedIn() &&
        (
          data.uidA == request.auth.uid ||
          data.uidB == request.auth.uid
        );
    }

    function scenarioAuthor(scenarioId) {
      return get(/databases/$(database)/documents/scenarios/$(scenarioId)).data.authorUid;
    }

    // --- Document shapes -------------------------------------------------
    //
    // Mirrors frontend/src/lib/schema/types.ts for the base collections, so a
    // write with a missing, extra or wrongly typed field is rejected instead of
    // stored. request.resource.data is the whole post-write document, so these
    // hold for partial updates too. Keep them in step with types.ts.

    function isStringOrNull(v) {
      return v == null || v is string;
    }

    function isNumberOrNull(v) {
      return v == null || v is number;
    }

    // serverTimestamp() resolves to request.time, so this pins a creation time
    // to the server clock rather than whatever the client sent.
    function stampedNow(v) {
      return v is timestamp && v == request.time;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function changed(field) {
      return request.resource.data[field] != resource.data[field];
    }

    function hasExactly(d, fields) {
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields);
    }

    function isValidUser(d) {
      return hasExactly(d, ['uid', 'username', 'usernameLower', 'displayName', 'avatarUrl', 'bio',
            'role', 'isBanned', 'isSocialRestricted', 'isProfilePublic', 'createdAt', 'updatedAt', 'friends', 'communities'])
        && d.uid is string
        && d.username is string
        && d.usernameLower == d.username.lower()
        && d.displayName is string
        && isStringOrNull(d.avatarUrl)
        && d.bio is string
        && d.role in ['user', 'moderator', 'admin']
        && d.isBanned is bool
        && d.isSocialRestricted is bool
        && d.isProfilePublic is bool
        && d.createdAt is timestamp
        && d.updatedAt is timestamp
        && d.friends is list
        && d.communities is list;
    }

    function isValidScenario(d, scenarioId) {
      return d.keys().hasAll(['id', 'authorUid', 'title', 'description', 'instrument', 'genres',
            'visibility', 'tags', 'authorDifficulty', 'crowdDifficulty', 'avgRating', 'ratingCount', 'playCount',
            'currentVersionId', 'currentVersionNumber', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['id', 'authorUid', 'title', 'description', 'instrument', 'genres',
            'visibility', 'tags', 'authorDifficulty', 'crowdDifficulty', 'avgRating', 'ratingCount', 'playCount',
            'currentVersionId', 'currentVersionNumber', 'createdAt', 'updatedAt', 'crowdDifficultyVersionId'])
        && isStringOrNull(d.get('crowdDifficultyVersionId', null))
        && d.id == scenarioId
        && d.authorUid is string
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && d.description is string
        && d.instrument in ['piano', 'guitar', 'woodwind', 'vocals', 'midi']
        && d.genres is list
        && d.visibility in ['private', 'unlisted', 'public']
        && d.tags is list
        && d.authorDifficulty is int && d.authorDifficulty >= 1 && d.authorDifficulty <= 10
        && isNumberOrNull(d.crowdDifficulty)
        && isNumberOrNull(d.avgRating)
        && d.ratingCount is int
        && d.playCount is int
        && isStringOrNull(d.currentVersionId)
        && d.currentVersionNumber is int
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidScenarioVersion(d, scenarioId, versionId) {
      return d.keys().hasAll(['id', 'scenarioId', 'versionNumber', 'chart', 'scoringRules',
            'durationMs', 'mediaAssetIds', 'createdByUid', 'createdAt'])
        && d.keys().hasOnly(['id', 'scenarioId', 'versionNumber', 'chart', 'scoringRules',
            'durationMs', 'mediaAssetIds', 'createdByUid', 'createdAt', 'metadata'])
        && d.get('metadata', {}) is map
        && d.id == versionId
        && d.scenarioId == scenarioId
        && d.versionNumber is int && d.versionNumber >= 1
        && d.chart is map
        && d.scoringRules is map
        && d.durationMs is number
        && d.mediaAssetIds is list
        && d.createdByUid is string
        && d.createdAt is timestamp;
    }

    function isValidRun(d, runId) {
      return hasExactly(d, ['id', 'userUid', 'scenarioId', 'scenarioVersionId', 'instrument',
            'partId', 'speedMultiplier', 'scoringRules', 'finalScore', 'breakdown', 'validation',
            'matchId', 'matchParticipantUid', 'playedAt'])
        && d.id == runId
        && d.userUid is string
        && d.scenarioId is string
        && d.scenarioVersionId is string
        && d.instrument in ['piano', 'guitar', 'woodwind', 'vocals', 'midi']
        && d.partId is string
        && d.speedMultiplier is number
        && d.scoringRules is map
        && d.finalScore is number
        && d.breakdown is map
        && d.validation in ['pending', 'accepted', 'rejected']
        && isStringOrNull(d.matchId)
        && isStringOrNull(d.matchParticipantUid)
        && d.playedAt is timestamp;
    }

    match /accountDeletions/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Public profiles are readable; only the owner edits their own, and only
    // an admin can flip the moderation flags.
    match /users/{uid} {
      allow read: if resource.data.isProfilePublic == true || isSelf(uid) || isAdmin();
      // A new account always starts as an unrestricted standard user; roles
      // and moderation flags are granted later, by an admin.
      allow create: if isSelf(uid)
        && isValidUser(request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.isBanned == false
        && request.resource.data.isSocialRestricted == false
        && stampedNow(request.resource.data.createdAt);
      allow update: if signedIn() && isValidUser(request.resource.data)
        && unchanged('uid')
        && unchanged('createdAt')
        && (
            isAdmin()
            || changed('friends')
            || changed('communities')
            || (
                isSelf(uid)
                && unchanged('role')
                && unchanged('isBanned')
                && unchanged('isSocialRestricted')
                && unchanged('friends')
            )
        );
      allow delete: if isAdmin();

      // Ratings are readable for leaderboards. Sign-up creates one per
      // instrument at the starting values; every change after that is the
      // server's, so a client can never move its own elo.
      match /skillRatings/{instrument} {
        allow read: if signedIn();
        allow create: if isSelf(uid)
          && hasExactly(request.resource.data, ['uid', 'instrument', 'elo', 'tier', 'gamesPlayed',
                'isProvisional', 'updatedAt'])
          && request.resource.data.uid == uid
          && instrument in ['piano', 'guitar', 'woodwind', 'vocals', 'midi']
          && request.resource.data.instrument == instrument
          && request.resource.data.elo == 400
          && request.resource.data.tier == 'bronze'
          && request.resource.data.gamesPlayed == 0
          && request.resource.data.isProvisional == true
          && stampedNow(request.resource.data.updatedAt);
        allow update, delete: if false;

        // Immutable match history: only the owner reads; Admin SDK writes it.
        match /history/{matchId} {
          allow read: if isSelf(uid);
          allow write: if false;
        }
      }
    }

    match /publicProfile/{uid} {
        allow read: if true;

        allow create, delete: if isSelf(uid) || isAdmin();

        allow update: if signedIn() && (changed('friends')
            || changed('communities')
            || isAdmin()
            || isSelf(uid));
    }

    // Reservations are public so the sign-up form can check availability, and
    // a user may only claim one that points at themselves.
    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if isSelf(request.resource.data.uid);
      allow update: if false;
      allow delete: if isSelf(resource.data.uid) || isAdmin();
    }

    match /userSettings/{uid} {
      allow read, write: if isSelf(uid);

      match /scenarioThemes/{themeName} {
        allow read, create, update, delete: if isSelf(uid);
      }
    }

    match /userPreferences/{uid} {
      allow read, create, update: if isSelf(uid);

      allow delete: if false || isAdmin();
    }

    // The preset avatars offered on the profile editor. Read-only to clients.
    match /avatars/{avatarId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /scenarios/{scenarioId} {
      // A missing document reads as empty (not denied), so a deleted scenario
      // or a stale link resolves cleanly; it discloses nothing but absence.
      allow read: if resource == null
        || resource.data.visibility != 'private'
        || isSelf(resource.data.authorUid)
        || isAdmin();
      // Aggregates (ratings, plays, crowd difficulty) are derived server-side,
      // so a client creates them at their defaults and never edits them.
      allow create: if isSelf(request.resource.data.authorUid)
        && isValidScenario(request.resource.data, scenarioId)
        && request.resource.data.crowdDifficulty == null
        && request.resource.data.get('crowdDifficultyVersionId', null) == null
        && request.resource.data.avgRating == null
        && request.resource.data.ratingCount == 0
        && request.resource.data.playCount == 0
        && stampedNow(request.resource.data.createdAt);
      allow update: if isValidScenario(request.resource.data, scenarioId)
        && unchanged('authorUid')
        && unchanged('createdAt')
        && (isAdmin()
          || (isSelf(resource.data.authorUid)
              && unchanged('crowdDifficulty')
              && request.resource.data.get('crowdDifficultyVersionId', null)
                 == resource.data.get('crowdDifficultyVersionId', null)
              && unchanged('avgRating')
              && unchanged('ratingCount')
              && unchanged('playCount')));
      allow delete: if isSelf(resource.data.authorUid) || isAdmin();

      // Versions are immutable once written — edits create a new version.
      // Aggregate difficulty is written by the API/Admin SDK, never by clients.
      match /difficultyEstimates/{versionId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/scenarios/$(scenarioId)).data.visibility != 'private'
              || isSelf(scenarioAuthor(scenarioId)) || isAdmin());
        allow write: if false;
      }

      match /versions/{versionId} {
        allow read: if get(/databases/$(database)/documents/scenarios/$(scenarioId)).data.visibility != 'private'
          || isSelf(scenarioAuthor(scenarioId))
          || isAdmin();
        // getAfter, not get: a new scenario and its first version are written
        // in one batch, and get() would not see the scenario yet.
        allow create: if isSelf(getAfter(/databases/$(database)/documents/scenarios/$(scenarioId)).data.authorUid)
          && isValidScenarioVersion(request.resource.data, scenarioId, versionId)
          && isSelf(request.resource.data.createdByUid)
          && stampedNow(request.resource.data.createdAt);
        // An author can only label a version; its contents never change.
        allow update: if isAdmin()
          || (isSelf(scenarioAuthor(scenarioId))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
              && (request.resource.data.name == null
                  || (request.resource.data.name is string
                      && request.resource.data.name.size() >= 1
                      && request.resource.data.name.size() <= 60)));
        // An author may only remove versions, never rewrite them: deleting a
        // scenario takes its versions with it, and reverting takes the later ones.
        // Anything else would leave a gap in the history or a dangling current version.
        allow delete: if isAdmin()
          || (isSelf(scenarioAuthor(scenarioId))
              && (!existsAfter(/databases/$(database)/documents/scenarios/$(scenarioId))
                  || resource.data.versionNumber
                     > getAfter(/databases/$(database)/documents/scenarios/$(scenarioId)).data.currentVersionNumber));
      }
    }

    match /mediaAssets/{assetId} {
      allow read: if signedIn();
      allow create: if isSelf(request.resource.data.ownerUid);
      allow update, delete: if isSelf(resource.data.ownerUid) || isAdmin();
    }

    // A client may submit its own run as 'pending'; only the server accepts it.
    match /runs/{runId} {
      allow read: if signedIn();
      allow create: if isSelf(request.resource.data.userUid)
        && isValidRun(request.resource.data, runId)
        && request.resource.data.validation == 'pending'
        && stampedNow(request.resource.data.playedAt);
      allow update, delete: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if signedIn()
        && (isAdmin() || request.auth.uid in resource.data.participantUids);
      // Matchmaking/session servers own membership, scores and all transitions.
      allow write: if false;

      match /participants/{uid} {
        allow read: if signedIn() && (isAdmin()
          || request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.participantUids);
        allow write: if false;
      }
    }

    // --------------------------------------------------
    // Friend requests
    // --------------------------------------------------

    match /friendRequests/{requestId} {
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/friendRequests/$(requestId)) ||
        isFriendRequestParticipant(resource.data)
      );

      function validFriendRequest(data) {
        return data.keys().hasAll(['potentialFriends', 'initiatorUid', 'status', 'createdAt'])
          && data.keys().hasOnly(['potentialFriends', 'initiatorUid', 'status', 'createdAt'])
          && isFriendRequestParticipant(data)
          && data.potentialFriends[0] is string && data.potentialFriends[1] is string
          && data.potentialFriends[0] != data.potentialFriends[1]
          && data.potentialFriends.hasAny([data.initiatorUid])
          && data.createdAt is timestamp
          && requestId == pairId(data.potentialFriends[0], data.potentialFriends[1]);
      }

      allow create: if validFriendRequest(request.resource.data)
        && request.resource.data.initiatorUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow list: if isFriendRequestParticipant(resource.data);

      allow update: if isFriendRequestParticipant(resource.data)
        && validFriendRequest(request.resource.data)
        && unchanged('potentialFriends') && unchanged('createdAt')
        && (
          (resource.data.status == 'pending'
            && request.auth.uid != resource.data.initiatorUid
            && unchanged('initiatorUid')
            && (request.resource.data.status == 'declined'
              || (request.resource.data.status == 'accepted'
                && existsAfter(/databases/$(database)/documents/friendships/$(requestId)))))
          || (resource.data.status == 'declined'
            && request.resource.data.status == 'pending'
            && request.resource.data.initiatorUid == request.auth.uid)
        );

      allow delete: if signedIn()
        && resource.data.potentialFriends.hasAny([request.auth.uid]);
    }

    // --------------------------------------------------
    // Established friendships
    // --------------------------------------------------

    match /friendships/{friendshipId} {

      allow get: if signedIn() && (
          !exists( /databases/$(database)/documents/friendships/$(friendshipId)) ||
          isFriendshipParticipant(resource.data)
      );

      allow list: if isFriendshipParticipant(resource.data);

      function acceptingFriendRequest() {
        let path = /databases/$(database)/documents/friendRequests/$(friendshipId);
        let before = get(path).data;
        let after = getAfter(path).data;
        return before.status == 'pending'
          && after.status == 'accepted'
          && before.initiatorUid != request.auth.uid
          && before.potentialFriends.hasAll([request.resource.data.uidA, request.resource.data.uidB]);
      }

      allow create: if signedIn() &&
        request.resource.data.keys().hasAll([
          'friends',
          'id',
          'uidA',
          'uidAWins',
          'uidB',
          'uidBWins',
          'totalFriendlies',
          'matchHistory',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'friends',
          'id',
          'uidA',
          'uidAWins',
          'uidB',
          'uidBWins',
          'totalFriendlies',
          'matchHistory',
          'createdAt'
        ]) &&
        request.resource.data.id == friendshipId &&
        request.resource.data.uidA < request.resource.data.uidB &&
        friendshipId == pairId(request.resource.data.uidA, request.resource.data.uidB) &&
        acceptingFriendRequest() &&
        request.resource.data.friends is list &&
        request.resource.data.friends.size() == 2 &&
        request.resource.data.friends.hasAll([
          request.resource.data.uidA,
          request.resource.data.uidB
        ]) &&
        request.auth.uid in [
          request.resource.data.uidA,
          request.resource.data.uidB
        ] &&
        request.resource.data.uidAWins == 0 &&
        request.resource.data.uidBWins == 0 &&
        request.resource.data.totalFriendlies == 0;

      // Either participant can remove the friendship.
      allow delete: if isFriendshipParticipant(resource.data);

      // Statistics remain server-managed.
      allow update: if false;
    }

    // --------------------------------------------------
    // Notifications
    // --------------------------------------------------

    match /notifications/{notificationId} {

      allow get, list: if isSelf(resource.data.notifiedUid);

      allow create: if signedIn()
        && request.resource.data.notifierUid == request.auth.uid
        && request.resource.data.notifiedUid != request.auth.uid
        && request.resource.data.read == false;

      allow update: if isSelf(resource.data.notifiedUid) &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['read']) &&
        request.resource.data.read is bool;

      allow delete: if isSelf(resource.data.notifiedUid);
    }

    // --------------------------------------------------
    // User presence
    // --------------------------------------------------

    // dnd is optional: sign-up writes it, but the heartbeat's merge write can
    // create the document on its own for accounts made before it existed.
    function isValidUserStatus(d) {
      return d.keys().hasAll(['lastHeartbeat'])
        && d.keys().hasOnly(['dnd', 'lastHeartbeat'])
        && d.get('dnd', false) is bool
        && d.lastHeartbeat is timestamp;
    }

    match /userStatus/{uid} {
      allow read: if signedIn();

      allow create: if isSelf(uid)
          && isValidUserStatus(request.resource.data)
          && request.resource.data.lastHeartbeat == request.time;

      // The heartbeat is pinned to the server clock whenever it moves; a dnd
      // toggle alone leaves it untouched.
      allow update: if isSelf(uid)
          && isValidUserStatus(request.resource.data)
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['dnd', 'lastHeartbeat'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastHeartbeat'])
              || request.resource.data.lastHeartbeat == request.time);

      allow delete: if false;
    }

    match /communities/{communityId} {
      allow read: if resource.data.isPublic == true || signedIn();
      allow create: if isSelf(request.resource.data.ownerUid);
      allow update: if (isSelf(resource.data.ownerUid) || isAdmin()) || (signedIn() && changed('memberCount'))
      allow delete: if isSelf(resource.data.ownerUid) || isAdmin();

      
      match /members/{uid} {
        allow read: if signedIn();

        allow create: if signedIn() && (
            isSelf(uid)
            || isSelf(
                get(/databases/$(database)/documents/communities/$(communityId))
                    .data.ownerUid
            )
            || isAdmin()
        );

        allow update, delete: if isSelf(uid)
            || isSelf(
                get(/databases/$(database)/documents/communities/$(communityId))
                    .data.ownerUid
            )
            || isAdmin();
      }

      match /announcements/{announcementId} {
        allow read: if signedIn();
        allow create: if isSelf(request.resource.data.announcerUid) && canPostAnnouncement(communityId, request.resource.data.announcerUid);
        allow update, delete: if signedIn() || isAdmin();
      }

      match /requests/{requestId} {
        allow read: if signedIn() && (
          isSelf(resource.data.memberUid)
          || isSelf(resource.data.outsiderUid)
          || isSelf(
            get(/databases/$(database)/documents/communities/$(communityId))
              .data.ownerUid
          )
          || isAdmin()
        );

        allow create: if signedIn() && (
          isSelf(request.resource.data.memberUid)
          || isSelf(request.resource.data.outsiderUid)
          || isSelf(
            get(/databases/$(database)/documents/communities/$(communityId))
              .data.ownerUid
          )
          || isAdmin()
        );

        allow update: if signedIn() && (
          isSelf(resource.data.memberUid)
          || isSelf(resource.data.outsiderUid)
          || isSelf(
            get(/databases/$(database)/documents/communities/$(communityId))
              .data.ownerUid
          )
          || isAdmin()
        );

        allow delete: if signedIn() && (
          isSelf(resource.data.memberUid)
          || isSelf(resource.data.outsiderUid)
          || isSelf(
            get(/databases/$(database)/documents/communities/$(communityId))
              .data.ownerUid
          )
          || isAdmin()
        );
      }
    }

    // Writes go through the backend's /playlists routes, which check names and duplicates.
    match /playlists/{playlistId} {
      allow read: if resource.data.isPublic == true || isSelf(resource.data.ownerUid);
      allow write: if false;
    }

    match /friendMatchInvitationLocks/{lockId} {
      allow read, write: if false;
    }

    // Document id is "{scenarioId}_{reviewerUid}", which is what makes one
    // review per user per scenario impossible to work around.
    match /scenarioReviews/{reviewId} {
      allow read: if true;
      allow create: if isSelf(request.resource.data.reviewerUid)
        && reviewId == request.resource.data.scenarioId + '_' + request.resource.data.reviewerUid;
      allow update: if isSelf(resource.data.reviewerUid);
      allow delete: if isSelf(resource.data.reviewerUid) || isAdmin();
    }

    match /userReports/{reportId} {
      allow read: if isSelf(resource.data.reporterUid) || isAdmin();
      allow create: if isSelf(request.resource.data.reporterUid)
        && request.resource.data.state == 'open';
      allow update, delete: if isAdmin();
    }

    match /moderationActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isSelf(request.resource.data.moderatorUid);
      allow update, delete: if false;
    }

    match /matchInvitations/{invitationId} {
      allow read: if isSelf(resource.data.fromUid) || isSelf(resource.data.toUid);
      allow create: if isSelf(request.resource.data.fromUid);
      allow update: if isSelf(resource.data.toUid) || isSelf(resource.data.fromUid);
      allow delete: if isSelf(resource.data.fromUid) || isAdmin();
    }

    match /recordingShares/{shareId} {
      allow read: if resource.data.visibility != 'private' || isSelf(resource.data.ownerUid);
      allow create: if isSelf(request.resource.data.ownerUid);
      allow update, delete: if isSelf(resource.data.ownerUid) || isAdmin();
    }

    function isValidScoreShare(d, shareId) {
      return hasExactly(d, ['id', 'ownerUid', 'runId', 'scenarioId', 'scenarioTitle',
            'finalScore', 'message', 'recipientUids', 'createdAt'])
        && d.id == shareId
        && d.scenarioTitle is string && d.scenarioTitle.size() <= 200
        && d.message is string && d.message.size() <= 140
        && d.recipientUids is list
        && d.recipientUids.size() > 0 && d.recipientUids.size() <= 50
        && stampedNow(d.createdAt);
    }

    // A result sent to friends. Only the run's own player can send it, and the score it shows
    // has to be the run's real score. Recipients and the sender can read it; nobody edits it.
    match /scoreShares/{shareId} {
      allow read: if isSelf(resource.data.ownerUid)
        || (signedIn() && request.auth.uid in resource.data.recipientUids);
      allow create: if isSelf(request.resource.data.ownerUid)
        && isValidScoreShare(request.resource.data, shareId)
        && !(request.auth.uid in request.resource.data.recipientUids)
        && get(/databases/$(database)/documents/runs/$(request.resource.data.runId)).data.userUid
          == request.auth.uid
        && get(/databases/$(database)/documents/runs/$(request.resource.data.runId)).data.finalScore
          == request.resource.data.finalScore
        && get(/databases/$(database)/documents/runs/$(request.resource.data.runId)).data.scenarioId
          == request.resource.data.scenarioId;
      allow update: if false;
      allow delete: if isSelf(resource.data.ownerUid) || isAdmin();
    }

    match /importJobs/{jobId} {
      allow read: if isSelf(resource.data.ownerUid) || isAdmin();
      allow create: if isSelf(request.resource.data.ownerUid)
        && request.resource.data.state == 'queued';
      // The worker advances the job server-side.
      allow update, delete: if isAdmin();
    }

    // Schema bookkeeping written by scripts/init-firestore.ts.
    match /_schema/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}