# Firebase web config. Copy to .env.local and fill in from
# Firebase console > Project settings > Your apps > SDK setup and configuration.
# Vite only exposes variables prefixed with VITE_.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Leave empty for local development: Vite forwards /api to the backend.
# Set an explicit backend origin only for separately hosted frontends.
VITE_API_BASE_URL=

# Backend reached by the Vite server, default http://127.0.0.1:8000.
# If each computer runs its own frontend, point both at one shared backend.
API_PROXY_TARGET=

# Local integration/demo only. Set BOTH and use VITE_FIREBASE_PROJECT_ID=demo-clash-of-jams.
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Optional: credentials the init script signs in with before seeding, so the
# writes happen as a real user instead of relying on test-mode rules.
FIREBASE_SEED_EMAIL=
FIREBASE_SEED_PASSWORD=
