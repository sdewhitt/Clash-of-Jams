# Copy to backend/.env and fill in. Loaded by app/config.py.

DEBUG=false

# Firebase project whose ID tokens this API accepts.
FIREBASE_PROJECT_ID=clash-of-jams
# Service account key path. Leave blank to use Application Default Credentials
# (gcloud auth application-default login).
GOOGLE_APPLICATION_CREDENTIALS=

# Local development only: skip token verification and treat every caller as
# AUTH_DEV_UID. Never set this to true in a deployment.
AUTH_DISABLED=false
AUTH_DEV_UID=dev-user

# JSON list. The Vite dev server origins are the defaults.
# CORS_ORIGINS=["http://localhost:5173"]
